spring.application.name=RoadRescue

# ---- MySQL connection ----
# Copy this file to application.properties and fill in your real values.
# NEVER commit application.properties with real passwords to GitHub.
spring.datasource.url=jdbc:mysql://localhost:3306/roadrescue_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

server.port=8080

# Maps are powered by Leaflet + OpenStreetMap (see templates/track.html) —
# no API key, billing, or signup required.
